# Environment variables
.env
.env.*
!.env.example

# Streamlit secrets (real values — never commit)
.streamlit/secrets.toml

# Dataset (too large for Git — must be downloaded separately)
data/*.csv
data/*.parquet
data/*.json

# Trained models — committed so Render can load them without retraining
# (both files are < 1 MB — well within GitHub limits)

# EDA plots — committed so Streamlit Cloud dashboard works without retraining

# BUT keep the placeholder files that make Git track empty folders
!data/.gitkeep
!models/.gitkeep
!eda_plots/.gitkeep

# Quarto output
reports/_site/
reports/.quarto/
reports/*_files/
reports/*.html

