# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment variables
.env
.env.*
!.env.example

# Dataset (too large for Git — must be downloaded separately)
data/*.csv
data/*.parquet
data/*.json

# Trained models (regenerated by train.py — too large for Git)
models/*.pkl
models/*.joblib

# EDA plots (regenerated by train.py)
eda_plots/*.png
eda_plots/*.jpg

# BUT keep the placeholder files that make Git track empty folders
!data/.gitkeep
!models/.gitkeep
!eda_plots/.gitkeep

# Quarto output
reports/_site/
reports/.quarto/
reports/*_files/
reports/*.html

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
