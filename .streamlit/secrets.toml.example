# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml for local development,
# OR paste the contents into the Streamlit Cloud secrets panel.
#
# HOW TO SET ON STREAMLIT CLOUD:
#   1. Open your app on share.streamlit.io
#   2. Click the three-dot menu → Settings → Secrets
#   3. Paste the line below (with your real Render URL)
#
# .streamlit/secrets.toml is in .gitignore — never commit real secrets.

API_URL = "https://your-app-name.onrender.com"
